      "numeric": {
        "value": 68.4932,
        "unit": "DDD/1000 inv/dag",
        "decimals": 1,
        "solution": [
          "Invånardagar: 40 000 × 365 = 14 600 000",
          "DDD per invånardag: 1 000 000 ÷ 14 600 000 = 0,068493",
          "Per 1000 invånare: 0,068493 × 1000 = 68,5 DDD/1000 inv/dag"
        ]
      }
